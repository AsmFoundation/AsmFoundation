<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The C# entry of the CRC-32C kernel: the loop a C# developer writes first (variant loop) and
    C# at its best, the assembly's 3-way algorithm in intrinsics (variant best). .NET's own
    library has no CRC-32C (System.IO.Hashing offers the IEEE CRC-32 and CRC-64 only), so both
    are written here. benchmarks/run.cs builds it in Release and runs the built dll.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>crc32c-csharp</AssemblyName>
    <RootNamespace>AsmFoundation.Benchmarks.Crc32C</RootNamespace>
  </PropertyGroup>
</Project>
